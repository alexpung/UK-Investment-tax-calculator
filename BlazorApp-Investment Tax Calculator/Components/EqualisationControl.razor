@using InvestmentTaxCalculator.Model
@using InvestmentTaxCalculator.Model.TaxEvents
@using InvestmentTaxCalculator.Model.UkTaxModel
@using InvestmentTaxCalculator.Model.Interfaces
@using InvestmentTaxCalculator.Services
@using InvestmentTaxCalculator.Enumerations

@inject UkSection104Pools Section104Pools
@inject TaxEventLists TaxEventLists
@inject ToastService ToastService
@inject CurrencyService CurrencyService
@inject EriEqualisationService EriEqualisationService

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">@(_editingEqualisation is null ? "Add Fund Equalisation" : "Edit Fund Equalisation")</h5>
    </div>
    <div class="card-body">
        @if (_editingEqualisation is not null)
        {
            <div class="alert alert-warning py-2 mb-3" role="alert">
                Editing the equalisation of <strong>@_editingEqualisation.Amount.BaseCurrencyAmount</strong> for <strong>@_editingEqualisation.AssetName</strong>. The income amounts below include it. Saving replaces it.
            </div>
        }
        <div class="form-grid">
            <div class="form-field form-field-wide">
                <label class="form-label">Ticker</label>
                <AssetNameSelector Value="@SelectedTicker"
                                   ValueChanged="@OnTickerChanged"
                                   AllowManualAssetNameInput="@AllowManualAssetNameInput"
                                   AssetCategoryFilter="@AssetCategoryFilter"
                                   IncludedAssetNames="@AvailableTickers"
                                   Placeholder="Select a ticker"
                                   CssClass="e-outline"
                                   Enabled="@(!IsCalculationMissing)" />
            </div>

            @if (!string.IsNullOrEmpty(SelectedTicker))
            {
                @* Wide fields keep each row full: Ticker + event, then amount + currency + rate *@
                <div class="form-field form-field-wide">
                    <label class="form-label">Income event to reduce</label>
                    <RadzenDropDown TValue="int?" Data="@AvailableIncomeEvents" TextProperty="DisplayText" ValueProperty="EventId"
                                    Value="@SelectedEventId" Placeholder="Select dividend/ERI" Change="@OnEventSelected" class="w-100" />
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(SelectedTicker) && SelectedEventId.HasValue)
        {
            var selectedEvent = AvailableIncomeEvents.FirstOrDefault(e => e.EventId == SelectedEventId)?.Event;
            @if (selectedEvent != null)
            {
                <div class="form-grid form-grid-follow">
                    <div class="form-field form-field-wide">
                        <label class="form-label">Equalisation amount (@Currency)</label>
                        <RadzenNumeric TValue="decimal" @bind-Value="@EqualisationAmount" Format="N2" Min="0" class="w-100" />
                    </div>

                    <div class="form-field">
                        <label class="form-label">Currency</label>
                        <div class="form-control form-control-readonly">@Currency</div>
                    </div>

                    <div class="form-field">
                        <label class="form-label">Exchange rate to GBP</label>
                        <div class="form-control form-control-readonly">@FxRate.ToString("N8")</div>
                    </div>
                </div>

                <div class="form-actions">
                    <RadzenButton ButtonStyle="ButtonStyle.Primary" Click="() => OnSubmit(selectedEvent)" Text="@(_editingEqualisation is null ? "Add Equalisation" : "Update Equalisation")" />
                    @if (_editingEqualisation is not null)
                    {
                        <RadzenButton ButtonStyle="ButtonStyle.Light" Click="CancelEdit" Text="Cancel" class="ms-2" />
                    }
                </div>
            }
        }
        else if (_editingEqualisation is not null)
        {
            <div class="form-actions">
                <RadzenButton ButtonStyle="ButtonStyle.Light" Click="CancelEdit" Text="Cancel edit" />
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public bool IsCalculationMissing { get; set; }
    [Parameter] public EventCallback OnDataChanged { get; set; }
    [Parameter] public bool AllowManualAssetNameInput { get; set; }
    [Parameter] public List<AssetCategoryType> AssetCategoryFilter { get; set; } = [AssetCategoryType.STOCK, AssetCategoryType.FUND];

    private List<string> AvailableTickers { get; set; } = new();
    private string SelectedTicker { get; set; } = string.Empty;
    private List<IncomeEventVM> AvailableIncomeEvents { get; set; } = new();
    private int? SelectedEventId { get; set; }
    private decimal EqualisationAmount { get; set; }
    private string Currency { get; set; } = "GBP";
    private List<CurrencyViewModel> Currencies { get; set; } = new();
    private decimal FxRate { get; set; } = 1.0m;
    private FundEqualisation? _editingEqualisation;
    // The income event reduced by the equalisation being edited; its amounts are shown with that reduction undone.
    private TaxEvent? _editingIncomeEvent;

    public class IncomeEventVM
    {
        public TaxEvent Event { get; set; } = null!;
        public int EventId => Event.Id;
        public string DisplayText { get; set; } = string.Empty;
    }

    protected override void OnInitialized()
    {
        Currencies = CurrencyService.GetCurrencies();
    }

    // Recomputed whenever the parent re-renders rather than once on initialisation: the available tickers derive
    // from the Section 104 pools and from CanonicalAssetName, both of which change when a calculation is run or
    // shares are linked, while this component instance outlives those changes.
    protected override void OnParametersSet()
    {
        var tickersWithIncome = TaxEventLists.Dividends.Where(d => d.DividendType != DividendType.WITHHOLDING).Select(d => d.CanonicalAssetName)
            .Union(TaxEventLists.InterestIncomes.Select(i => i.CanonicalAssetName))
            .ToHashSet();

        AvailableTickers = Section104Pools.GetSection104s()
            .Where(p => TaxEventLists.Trades.Any(t => t.IsSameAsset(p.AssetName) && t.AssetType is AssetCategoryType.STOCK or AssetCategoryType.FUND))
            .Select(p => p.AssetName)
            .Where(name => tickersWithIncome.Contains(name))
            .Distinct()
            .OrderBy(a => a)
            .ToList();
    }

    /// <summary>
    /// Loads an existing equalisation entry into the form. Submitting then replaces it instead of adding a new one.
    /// </summary>
    public void BeginEdit(FundEqualisation equalisation)
    {
        _editingEqualisation = equalisation;
        _editingIncomeEvent = EriEqualisationService.FindIncomeForEqualisation(equalisation);
        SelectedTicker = equalisation.AssetName;
        RefreshAvailableEvents();
        SelectedEventId = _editingIncomeEvent?.Id;
        OnEventSelected(SelectedEventId!);
        EqualisationAmount = equalisation.Amount.Amount.Amount;
        StateHasChanged();
    }

    public void CancelEdit()
    {
        ResetForm();
        StateHasChanged();
    }

    private void ResetForm()
    {
        _editingEqualisation = null;
        _editingIncomeEvent = null;
        SelectedTicker = string.Empty;
        SelectedEventId = null;
        EqualisationAmount = 0;
        Currency = "GBP";
        FxRate = 1.0m;
        AvailableIncomeEvents.Clear();
    }

    private DescribedMoney DisplayedIncomeMoney(TaxEvent incomeEvent)
    {
        DescribedMoney money = EriEqualisationService.GetIncomeMoney(incomeEvent);
        if (_editingEqualisation is null || !ReferenceEquals(incomeEvent, _editingIncomeEvent)) return money;
        WrappedMoney reductionLocal = new(_editingEqualisation.Amount.BaseCurrencyAmount.Amount / money.FxRate, money.Amount.Currency);
        return money with { Amount = money.Amount + reductionLocal };
    }

    private Task OnTickerChanged(string ticker)
    {
        SelectedTicker = ticker;
        SelectedEventId = null;
        Currency = "GBP";
        FxRate = 1.0m;
        RefreshAvailableEvents();
        return Task.CompletedTask;
    }

    private void OnEventSelected(object value)
    {
        SelectedEventId = value as int?;
        var selectedEvent = AvailableIncomeEvents.FirstOrDefault(e => e.EventId == SelectedEventId)?.Event;
        if (selectedEvent != null)
        {
            if (selectedEvent is Dividend d)
            {
                Currency = d.Proceed.Amount.Currency;
                FxRate = d.Proceed.FxRate;
            }
            else if (selectedEvent is InterestIncome i)
            {
                Currency = i.Amount.Amount.Currency;
                FxRate = i.Amount.FxRate;
            }
        }
        else
        {
            Currency = "GBP";
            FxRate = 1.0m;
        }
    }

    private void RefreshAvailableEvents()
    {
        AvailableIncomeEvents.Clear();
        if (string.IsNullOrEmpty(SelectedTicker)) return;

        var dividends = TaxEventLists.Dividends.Where(d => d.IsSameAsset(SelectedTicker) && d.DividendType != DividendType.WITHHOLDING);
        var interest = TaxEventLists.InterestIncomes.Where(i => i.IsSameAsset(SelectedTicker));
        
        foreach(var d in dividends) 
        {
            AvailableIncomeEvents.Add(new IncomeEventVM { 
                Event = d, 
                DisplayText = $"{d.Date:d} - {DisplayedIncomeMoney(d).Display()} ({d.DividendType.GetDescription()})" 
            });
        }
        foreach(var i in interest) 
        {
            AvailableIncomeEvents.Add(new IncomeEventVM { 
                Event = i, 
                DisplayText = $"{i.Date:d} - {DisplayedIncomeMoney(i).Display()} ({i.InterestType.GetDescription()})" 
            });
        }
        
        AvailableIncomeEvents = AvailableIncomeEvents.OrderByDescending(e => e.Event.Date).ToList();
    }

    private async Task OnSubmit(TaxEvent selectedEvent)
    {
        if (selectedEvent == null || EqualisationAmount <= 0 || FxRate <= 0)
        {
            ToastService.ShowError("Please select an event and enter a valid amount and exchange rate.");
            return;
        }

        try
        {
            bool isEdit = _editingEqualisation is not null;
            FundEqualisation equalisation = isEdit
                ? EriEqualisationService.UpdateEqualisation(_editingEqualisation!, SelectedTicker, selectedEvent, EqualisationAmount)
                : EriEqualisationService.AddEqualisation(SelectedTicker, selectedEvent, EqualisationAmount);
            ToastService.ShowInformation($"Successfully {(isEdit ? "updated" : "added")} equalisation of {equalisation.Amount.BaseCurrencyAmount} and reduced income.");
        }
        catch (InvalidOperationException ex)
        {
            ToastService.ShowError(ex.Message);
            return;
        }

        ResetForm();
        await OnDataChanged.InvokeAsync();
    }
}
