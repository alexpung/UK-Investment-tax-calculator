@using InvestmentTaxCalculator.Model
@using InvestmentTaxCalculator.Model.TaxEvents
@using InvestmentTaxCalculator.Model.UkTaxModel
@using InvestmentTaxCalculator.Model.Interfaces
@using InvestmentTaxCalculator.Services
@using InvestmentTaxCalculator.Enumerations

@inject UkSection104Pools Section104Pools
@inject TaxEventLists TaxEventLists
@inject ToastService ToastService

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Add Fund Equalisation</h5>
    </div>
    <div class="card-body">
        <div class="form-grid">
            <div class="form-field form-field-wide">
                <label class="form-label">Ticker</label>
                <AssetNameSelector Value="@SelectedTicker"
                                   ValueChanged="@OnTickerChanged"
                                   AllowManualAssetNameInput="@AllowManualAssetNameInput"
                                   AssetCategoryFilter="@AssetCategoryFilter"
                                   IncludedAssetNames="@AvailableTickers"
                                   Placeholder="Select a ticker"
                                   CssClass="e-outline"
                                   Enabled="@(!IsCalculationMissing)" />
            </div>

            @if (!string.IsNullOrEmpty(SelectedTicker))
            {
                @* Wide fields keep each row full: Ticker + event, then amount + currency + rate *@
                <div class="form-field form-field-wide">
                    <label class="form-label">Income event to reduce</label>
                    <RadzenDropDown TValue="int?" Data="@AvailableIncomeEvents" TextProperty="DisplayText" ValueProperty="EventId"
                                    Value="@SelectedEventId" Placeholder="Select dividend/ERI" Change="@OnEventSelected" class="w-100" />
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(SelectedTicker) && SelectedEventId.HasValue)
        {
            var selectedEvent = AvailableIncomeEvents.FirstOrDefault(e => e.EventId == SelectedEventId)?.Event;
            @if (selectedEvent != null)
            {
                <div class="form-grid form-grid-follow">
                    <div class="form-field form-field-wide">
                        <label class="form-label">Equalisation amount (@Currency)</label>
                        <RadzenNumeric TValue="decimal" @bind-Value="@EqualisationAmount" Format="N2" Min="0" class="w-100" />
                    </div>

                    <div class="form-field">
                        <label class="form-label">Currency</label>
                        <div class="form-control form-control-readonly">@Currency</div>
                    </div>

                    <div class="form-field">
                        <label class="form-label">Exchange rate to GBP</label>
                        <div class="form-control form-control-readonly">@FxRate.ToString("N8")</div>
                    </div>
                </div>

                <div class="form-actions">
                    <RadzenButton ButtonStyle="ButtonStyle.Primary" Click="() => OnSubmit(selectedEvent)" Text="Add Equalisation" />
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public bool IsCalculationMissing { get; set; }
    [Parameter] public EventCallback OnDataChanged { get; set; }
    [Parameter] public bool AllowManualAssetNameInput { get; set; }
    [Parameter] public List<AssetCategoryType> AssetCategoryFilter { get; set; } = [AssetCategoryType.STOCK, AssetCategoryType.FUND];

    private List<string> AvailableTickers { get; set; } = new();
    private string SelectedTicker { get; set; } = string.Empty;
    private List<IncomeEventVM> AvailableIncomeEvents { get; set; } = new();
    private int? SelectedEventId { get; set; }
    private decimal EqualisationAmount { get; set; }
    private string Currency { get; set; } = "GBP";
    private decimal FxRate { get; set; } = 1.0m;

    /// <summary>
    /// An income an equalisation entry can reduce: a stored fund distribution (dividend or interest) or an ERI entry.
    /// </summary>
    public class IncomeEventVM
    {
        public required TaxEvent Event { get; init; }
        public required DescribedMoney Money { get; init; }
        public required string TypeDescription { get; init; }
        public required EqualisationIncomeSource Source { get; init; }
        public int EventId => Event.Id;
        public string DisplayText => $"{Event.Date:d} - {Money.Display()} ({TypeDescription})";
    }

    /// <summary>
    /// Lists the fund tickers with income an equalisation can reduce. Recomputed whenever the parent re-renders
    /// rather than once on initialisation: the available tickers derive from the Section 104 pools and from
    /// CanonicalAssetName, both of which change when a calculation is run or shares are linked, while this
    /// component instance outlives those changes.
    /// </summary>
    protected override void OnParametersSet()
    {
        var tickersWithIncome = TaxEventLists.Dividends.Where(ReportingFundIncomeResolver.IsDistribution).Select(d => d.CanonicalAssetName)
            .Union(TaxEventLists.InterestIncomes.Where(ReportingFundIncomeResolver.IsDistribution).Select(i => i.CanonicalAssetName))
            .Union(TaxEventLists.CorporateActions.OfType<ExcessReportableIncome>().Select(e => e.CanonicalAssetName))
            .ToHashSet();

        AvailableTickers = Section104Pools.GetSection104s()
            .Where(p => TaxEventLists.Trades.Any(t => t.IsSameAsset(p.AssetName) && t.AssetType is AssetCategoryType.STOCK or AssetCategoryType.FUND))
            .Select(p => p.AssetName)
            .Where(name => tickersWithIncome.Contains(name))
            .Distinct()
            .OrderBy(a => a)
            .ToList();
    }

    /// <summary>
    /// Clears the form, e.g. after an entry is deleted so a stale income selection cannot be submitted.
    /// </summary>
    public void Reset()
    {
        ResetForm();
        StateHasChanged();
    }

    private void ResetForm()
    {
        SelectedTicker = string.Empty;
        SelectedEventId = null;
        EqualisationAmount = 0;
        Currency = "GBP";
        FxRate = 1.0m;
        AvailableIncomeEvents = new();
    }

    private Task OnTickerChanged(string ticker)
    {
        SelectedTicker = ticker;
        SelectedEventId = null;
        Currency = "GBP";
        FxRate = 1.0m;
        RefreshAvailableEvents();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Takes the currency and FX rate from the selected income, which the equalisation amount is entered in.
    /// </summary>
    private void OnEventSelected(object value)
    {
        SelectedEventId = value as int?;
        IncomeEventVM? selected = AvailableIncomeEvents.FirstOrDefault(e => e.EventId == SelectedEventId);
        Currency = selected?.Money.Amount.Currency ?? "GBP";
        FxRate = selected?.Money.FxRate ?? 1.0m;
    }

    /// <summary>
    /// Lists the incomes of the selected ticker an equalisation can reduce: fund distributions and ERI entries.
    /// </summary>
    private void RefreshAvailableEvents()
    {
        List<IncomeEventVM> events = [];
        if (!string.IsNullOrEmpty(SelectedTicker))
        {
            events.AddRange(TaxEventLists.Dividends
                .Where(d => d.IsSameAsset(SelectedTicker) && ReportingFundIncomeResolver.IsDistribution(d))
                .Select(d => new IncomeEventVM { Event = d, Money = d.Proceed, TypeDescription = d.DividendType.GetDescription(), Source = EqualisationIncomeSource.Distribution }));
            events.AddRange(TaxEventLists.InterestIncomes
                .Where(i => i.IsSameAsset(SelectedTicker) && ReportingFundIncomeResolver.IsDistribution(i))
                .Select(i => new IncomeEventVM { Event = i, Money = i.Amount, TypeDescription = i.InterestType.GetDescription(), Source = EqualisationIncomeSource.Distribution }));
            events.AddRange(TaxEventLists.CorporateActions.OfType<ExcessReportableIncome>()
                .Where(e => e.IsSameAsset(SelectedTicker))
                .Select(e => new IncomeEventVM { Event = e, Money = e.Amount, TypeDescription = $"Excess Reportable Income ({e.IncomeType.GetDescription()})", Source = EqualisationIncomeSource.ExcessReportableIncome }));
        }
        AvailableIncomeEvents = [.. events.OrderByDescending(e => e.Event.Date)];
        // Drop a selection whose income has gone (e.g. its ERI entry was deleted).
        if (SelectedEventId is not null && !AvailableIncomeEvents.Any(e => e.EventId == SelectedEventId))
        {
            SelectedEventId = null;
        }
    }

    /// <summary>
    /// Adds an equalisation entry against the selected income, after checking against the current data that it
    /// matches that income and does not exceed what is left of it.
    /// </summary>
    private async Task OnSubmit(TaxEvent selectedEvent)
    {
        IncomeEventVM? income = AvailableIncomeEvents.FirstOrDefault(e => ReferenceEquals(e.Event, selectedEvent));
        if (income is null || EqualisationAmount <= 0 || FxRate <= 0)
        {
            ToastService.ShowError("Please select an event and enter a valid amount and exchange rate.");
            return;
        }

        string relatedDescription = $"{income.TypeDescription} on {selectedEvent.Date:d}";
        // Only the equalisation entry is stored. The income reduction and section 104 cost reduction are derived
        // from it at calculation time, matched to the income by asset, date, income source and income type.
        FundEqualisation equalisation = new()
        {
            AssetName = SelectedTicker,
            Date = selectedEvent.Date,
            Amount = new DescribedMoney(EqualisationAmount, Currency, FxRate, relatedDescription),
            RelatedEventDescription = relatedDescription,
            IncomeSource = income.Source,
            IncomeEventType = ReportingFundIncomeResolver.IncomeEventTypeOf(selectedEvent),
            // Carrying the share's ISIN lets the share identity registry match the entry to its income even when
            // that income is later recorded under another ticker of the same share.
            Isin = selectedEvent.Isin
        };

        // Check the entry against the current data with the same matching rule the calculation uses, so a stale
        // selection (income deleted since it was listed) or an income that cannot be told apart from another one on
        // the same date is caught, as is a total exceeding the income.
        TaxEventLists.CorporateActions.Add(equalisation);
        string? error = null;
        TaxEvent? matchedIncome = ReportingFundIncomeResolver.FindIncome(equalisation, TaxEventLists);
        if (matchedIncome is null)
        {
            error = "The selected income no longer exists. Please select the income again.";
        }
        else if (!ReferenceEquals(matchedIncome, selectedEvent))
        {
            error = "Another income of this ticker, date and type exists, so this equalisation cannot be matched to the selected one.";
        }
        else if (ReportingFundIncomeResolver.FindOverEqualised(TaxEventLists).Contains(equalisation))
        {
            WrappedMoney incomeAmount = ReportingFundIncomeResolver.IncomeMoneyOf(selectedEvent).BaseCurrencyAmount;
            WrappedMoney alreadyEqualised = ReportingFundIncomeResolver.GroupEqualisationsByIncome(TaxEventLists)[selectedEvent]
                .Where(e => !ReferenceEquals(e, equalisation)).Sum(e => e.Amount.BaseCurrencyAmount);
            error = $"Equalisation amount ({equalisation.Amount.BaseCurrencyAmount}) cannot exceed the income amount not already equalised ({incomeAmount - alreadyEqualised}).";
        }
        if (error is not null)
        {
            TaxEventLists.CorporateActions.Remove(equalisation);
            RefreshAvailableEvents();
            ToastService.ShowError(error);
            return;
        }

        ToastService.ShowInformation($"Successfully added equalisation of {equalisation.Amount.BaseCurrencyAmount}.");
        ResetForm();
        await OnDataChanged.InvokeAsync();
    }
}
