@using InvestmentTaxCalculator.Model
@using InvestmentTaxCalculator.Model.TaxEvents
@using InvestmentTaxCalculator.Model.UkTaxModel
@using InvestmentTaxCalculator.Model.Interfaces
@using InvestmentTaxCalculator.Services
@using InvestmentTaxCalculator.Enumerations

@inject UkSection104Pools Section104Pools
@inject TaxCalculationService TaxCalculationService
@inject TaxEventLists TaxEventLists
@inject ToastService ToastService
@inject CurrencyService CurrencyService

@* Laid out with the shared entry-form-grid (app.css) rather than Bootstrap columns: the card is only half the
   window when shown beside the equalisation card, and the grid sizes itself from the card rather than the viewport. *@
<div class="card bg-secondary text-white">
    <div class="card-header bg-info text-dark">
        <h5 class="mb-0">Add Excess Reportable Income (ERI)</h5>
    </div>
    <div class="card-body">
        <div class="entry-form-grid">
            <div class="entry-field">
                <label class="form-label">Accounting Period End Date</label>
                <RadzenDatePicker TValue="DateTime?" Value="@PeriodEndDate" DateFormat="d" Change="@OnDateChanged" Placeholder="Pick period end date" class="w-100" />
            </div>

            @if (PeriodEndDate.HasValue)
            {
                <div class="entry-field">
                    <label class="form-label">Ticker</label>
                    <AssetNameSelector Value="@SelectedTicker"
                                       ValueChanged="@OnTickerChanged"
                                       AllowManualAssetNameInput="@AllowManualAssetNameInput"
                                       AssetCategoryFilter="@AssetCategoryFilter"
                                       HoldingDate="@PeriodEndDate"
                                       RequirePositiveHoldingOnDate="true"
                                       Placeholder="Select a ticker"
                                       CssClass="e-outline" />
                </div>

                @if (!string.IsNullOrEmpty(SelectedTicker))
                {
                    <div class="entry-field">
                        <label class="form-label">Quantity at Period End</label>
                        @if (TaxCalculationService.HasCurrentResult)
                        {
                            <div class="form-control bg-dark text-info border-info">@Quantity.ToString("N4")</div>
                        }
                        else
                        {
                            <div class="form-control bg-dark text-warning border-warning">Calculation pending</div>
                        }
                    </div>

                    <div class="entry-field">
                        <label class="form-label">Income Type</label>
                        <RadzenDropDown TValue="ExcessReportableIncomeType" Data="@IncomeTypes" TextProperty="Description" ValueProperty="EnumValue" @bind-Value="@SelectedIncomeType" class="w-100" />
                    </div>

                    <div class="entry-field">
                        <label class="form-label">Income Per Share (Local Currency)</label>
                        <RadzenNumeric TValue="decimal" @bind-Value="@IncomePerShare" Format="N8" Min="0" class="w-100" />
                    </div>

                    <div class="entry-field">
                        <label class="form-label">Currency</label>
                        <RadzenDropDown TValue="string" Data="@Currencies" TextProperty="Code" ValueProperty="Code" @bind-Value="@Currency" AllowFiltering="true" class="w-100" />
                    </div>

                    <div class="entry-field">
                        <label class="form-label">Exchange Rate (to GBP)</label>
                        <RadzenNumeric TValue="decimal" @bind-Value="@FxRate" Format="N8" Min="0" class="w-100" />
                    </div>

                    @if (!string.IsNullOrEmpty(GetIsinForTicker(SelectedTicker, PeriodEndDate.Value)))
                    {
                        string isin = GetIsinForTicker(SelectedTicker, PeriodEndDate.Value);
                        <div class="entry-field">
                            <label class="form-label">Detected Region (from ISIN)</label>
                            <div class="form-control bg-dark text-info border-info text-truncate" title="@isin">
                                @CountryCode.GetRegionByTwoDigitCode(isin[..2]).CountryName (@isin[..2]) - @isin
                            </div>
                        </div>
                    }

                    @* The breakdown table needs the width of the card rather than the width of the single grid column
                       the quantity sits in, so it is given a row of its own under the fields it explains. *@
                    @if (TaxCalculationService.HasCalculated)
                    {
                        <div class="entry-field-full">
                            <span class="form-label d-block mb-1">Quantity breakdown for @SelectedTicker</span>
                            <HoldingBreakdown AssetName="@SelectedTicker" AsOfDate="@PeriodEndDate.Value" />
                        </div>
                    }

                    <div class="entry-field-full mt-2 d-flex justify-content-center">
                        <RadzenButton ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Large" Click="OnSubmit" Text="Add ERI Entry" />
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnDataChanged { get; set; }
    [Parameter] public bool AllowManualAssetNameInput { get; set; }
    [Parameter] public List<AssetCategoryType> AssetCategoryFilter { get; set; } = [AssetCategoryType.STOCK, AssetCategoryType.FUND];

    private DateTime? PeriodEndDate { get; set; }
    private string SelectedTicker { get; set; } = string.Empty;
    private decimal Quantity { get; set; }
    private decimal IncomePerShare { get; set; }
    private string Currency { get; set; } = "GBP";
    private List<CurrencyViewModel> Currencies { get; set; } = new();
    private decimal FxRate { get; set; } = 1.0m;
    private ExcessReportableIncomeType SelectedIncomeType { get; set; } = ExcessReportableIncomeType.DIVIDEND;
    private List<EnumDescriptionPair<ExcessReportableIncomeType>> IncomeTypes { get; set; } = new();

    protected override void OnInitialized()
    {
        IncomeTypes = EnumExtensions.GetEnumDescriptionPair<ExcessReportableIncomeType>(typeof(ExcessReportableIncomeType));
        Currencies = CurrencyService.GetCurrencies();
    }

    private void OnDateChanged(DateTime? date)
    {
        PeriodEndDate = date;
        SelectedTicker = string.Empty;
        Quantity = 0m;
    }

    // A calculation rebuilds the Section 104 pools, so the quantity for an already selected ticker has to be read
    // again. Without this it stays at the zero recorded before the calculation and the entry is rejected until the
    // user reselects the ticker.
    protected override void OnParametersSet() => RefreshQuantity();

    private Task OnTickerChanged(string ticker)
    {
        SelectedTicker = ticker;
        RefreshQuantity();
        return Task.CompletedTask;
    }

    private void RefreshQuantity()
    {
        // GetExistingOrNull rather than GetExistingOrInitialise: tickers are selectable before a calculation has run,
        // so this must not leave an empty pool behind for one that has no pool yet.
        Quantity = !string.IsNullOrEmpty(SelectedTicker) && PeriodEndDate.HasValue
            ? Section104Pools.GetExistingOrNull(SelectedTicker)?.GetLastSection104History(DateOnly.FromDateTime(PeriodEndDate.Value))?.NewQuantity ?? 0m
            : 0m;
    }

    // A share can carry more than one ISIN over time (a Newco insertion or re-issue), and the ISIN determines the
    // region the income is taxed in. Take the most recent one in force at the end of the reporting period rather
    // than whichever event happens to come first in the list, which is an arbitrary order.
    private string GetIsinForTicker(string ticker, DateTime asOfDate)
    {
        List<TaxEvent> datedIsinEvents = [.. TaxEventLists.Trades.Cast<TaxEvent>()
            .Concat(TaxEventLists.Dividends)
            .Where(taxEvent => taxEvent.IsSameAsset(ticker) && !string.IsNullOrEmpty(taxEvent.Isin))];

        string? isinAtPeriodEnd = datedIsinEvents
            .Where(taxEvent => taxEvent.Date <= asOfDate)
            .OrderByDescending(taxEvent => taxEvent.Date)
            .Select(taxEvent => taxEvent.Isin)
            .FirstOrDefault();
        // Nothing on or before the period end (e.g. an ERI period preceding the first recorded event): fall back
        // to the earliest ISIN known for the share.
        return isinAtPeriodEnd
            ?? datedIsinEvents.OrderBy(taxEvent => taxEvent.Date).Select(taxEvent => taxEvent.Isin).FirstOrDefault()
            ?? string.Empty;
    }

    private async Task OnSubmit()
    {
        if (!TaxCalculationService.HasCurrentResult)
        {
            // The ERI amount is quantity times income per share and is frozen into the saved event, so it cannot be
            // entered before the holding at the period end is known.
            ToastService.ShowError("Run the calculation so the quantity held at the period end is up to date.");
            return;
        }
        if (!PeriodEndDate.HasValue || string.IsNullOrEmpty(SelectedTicker) || Quantity <= 0 || IncomePerShare <= 0 || FxRate <= 0)
        {
            ToastService.ShowError("Please fill in all fields correctly.");
            return;
        }

        string isin = GetIsinForTicker(SelectedTicker, PeriodEndDate.Value);
        CountryCode region = string.IsNullOrEmpty(isin) || isin.Length < 2
            ? CountryCode.UnknownRegion 
            : CountryCode.GetRegionByTwoDigitCode(isin[..2]);

        DateTime distributionDate = PeriodEndDate.Value.AddMonths(6);
        decimal totalAmountLocal = Quantity * IncomePerShare;

        var eri = new ExcessReportableIncome
        {
            AssetName = SelectedTicker,
            Date = distributionDate,
            ReportingPeriodEndDate = PeriodEndDate.Value,
            IncomeType = SelectedIncomeType,
            Amount = new DescribedMoney(totalAmountLocal, Currency, FxRate, $"ERI for {Quantity:N4} shares (Period End: {PeriodEndDate.Value:d})"),
            Isin = isin,
            IncomeLocation = region
        };

        TaxEventLists.CorporateActions.Add(eri);

        if (SelectedIncomeType == ExcessReportableIncomeType.DIVIDEND)
        {
            TaxEventLists.Dividends.Add(new Dividend
            {
                AssetName = SelectedTicker,
                Date = distributionDate,
                DividendType = DividendType.EXCESS_REPORTABLE_INCOME,
                Proceed = new DescribedMoney(totalAmountLocal, Currency, FxRate, $"Excess Reportable Income (Dividend) from {SelectedTicker}"),
                Isin = isin,
                CompanyLocation = region
            });
        }
        else
        {
            TaxEventLists.InterestIncomes.Add(new InterestIncome
            {
                AssetName = SelectedTicker,
                Date = distributionDate,
                InterestType = InterestType.EXCESSREPORTABLEINCOME,
                Amount = new DescribedMoney(totalAmountLocal, Currency, FxRate, $"Excess Reportable Income (Interest) from {SelectedTicker}"),
                Isin = isin,
                IncomeLocation = region
            });
        }

        ToastService.ShowInformation($"Successfully added ERI of {eri.Amount.BaseCurrencyAmount} for {SelectedTicker}.");
        
        SelectedTicker = string.Empty;
        IncomePerShare = 0;

        await OnDataChanged.InvokeAsync();
    }
}
