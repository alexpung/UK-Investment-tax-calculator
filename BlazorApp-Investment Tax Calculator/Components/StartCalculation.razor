@using System.Collections.ObjectModel

<div class="card">
    <div class="card-header">
        <h3 class="mb-0">Calculate Taxes</h3>
    </div>
    <div class="card-body">
        <p class="text-muted mb-3">
            Process your imported data to calculate capital gains, losses, dividends, and other tax obligations 
            according to UK tax rules. This may take a few moments for large datasets.
        </p>
        
        @if (FileImportState.IsProcessing)
        {
            <div class="alert alert-warning alert-custom mb-3" role="alert">
                <small><strong>Please wait</strong> - Files are still being processed. The calculation button will be enabled once import is complete.</small>
            </div>
        }
        
        <div class="mb-3">
            <RadzenCheckBox @bind-Value="@OptionCalculationSetting.DeductClosingCostInWrittenTaxYear" Name="deductClosingCostInWrittenTaxYear"
                            Disabled="@TaxCalculationService.IsCalculating" />
            <RadzenLabel Text="Deduct closing cost of written options in the tax year the option was written"
                         Component="deductClosingCostInWrittenTaxYear" class="ms-2" />
            <div class="form-text">
                By default, a written option closed, assigned or cash settled in a later tax year is taxed on the full premium in the year it was written,
                and the closing cost is listed in the tax refund table instead of being deducted.
                Tick this to deduct the closing cost from the gain of the tax year the option was written instead, e.g. if the option was closed before you filed that year's tax return.
                Written options without a closing trade are still taxed on the full premium.
            </div>
        </div>

        <RadzenButton Click="OnStartCalculation"
                      ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large"
                      Disabled="@(TaxCalculationService.IsCalculating || FileImportState.IsProcessing)">
            @if (TaxCalculationService.IsCalculating)
            {
                <span>Calculating...</span>
            }
            else
            {
                <span>Start Calculation</span>
            }
        </RadzenButton>
    </div>
</div>
