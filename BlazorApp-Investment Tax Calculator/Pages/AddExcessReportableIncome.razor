@page "/AddExcessReportableIncome"
@using InvestmentTaxCalculator.Model
@using InvestmentTaxCalculator.Model.TaxEvents
@using InvestmentTaxCalculator.Model.UkTaxModel
@using InvestmentTaxCalculator.Model.Interfaces
@using InvestmentTaxCalculator.Services
@using InvestmentTaxCalculator.Enumerations
@using InvestmentTaxCalculator.Components

@implements IDisposable
@inject UkSection104Pools Section104Pools
@inject TaxEventLists TaxEventLists
@inject ToastService ToastService
@inject ITaxYear TaxYear
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject TaxCalculationService TaxCalculationService
@inject ShareIdentityRegistry ShareIdentityRegistry

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <!-- Page Header -->
            <div class="page-header">
                <h1 class="page-title">ERI and Fund Equalisation</h1>
                <p class="page-subtitle">Manage Excess Reportable Income and fund equalisation payments</p>
            </div>

            <!-- Guidance Section -->
            <div class="alert alert-info alert-custom mb-4" role="alert">
                <h5 class="alert-heading">Guidance & How to Use</h5>
                
                <div class="mb-3">
                    <h6 class="fw-bold">How to Use:</h6>
                    <ol class="mb-2">
                        <li><strong>Add ERI:</strong> Enter the fund's accounting period end date, ticker, and income per share. This calculates the total ERI based on your holdings at that date.</li>
                        <li><strong>Add Equalisation:</strong> Select the fund ticker and the specific income event (Dividend or ERI) to be reduced by the equalisation amount.</li>
                        <li><strong>Correcting a mistake:</strong> Delete the entry in the history table below and add it again. The ERI income, the equalisation reduction and the Section 104 adjustments are worked out from the entries every time the calculation runs, so nothing else needs undoing. Deleting an ERI entry also deletes the equalisation entries that reduce it.</li>
                    </ol>
                </div>

                <div class="mb-3">
                    <h6 class="fw-bold">Important Workflow Notes:</h6>
                    <ul class="mb-0">
                        <li><strong>Accumulating Funds:</strong> For accumulating funds with equalisation, you must <strong>add the Excess Reportable Income (ERI) first</strong>. Once added, you can then select that ERI entry in the Equalisation section to reduce it.</li>
                        <li><strong>Ticker Selection:</strong> Some available tickers may be standard stocks (non-funds). Ensure you only apply ERI or Equalisation to appropriate offshore fund assets.</li>
                        <li><strong>Manual Matching:</strong> You are responsible for matching equalisation payments to the correct corresponding income event as per your broker's tax reports.</li>
                        <li><strong>Export & Backup:</strong> All manual entries are saved automatically to the session. You can export the entire session (including ERI and Equalisation) for future use from the <a href="CalculatePage" class="alert-link">Calculate &amp; export page</a>.</li>
                    </ul>
                </div>
            </div>

            @if (_isCalculationMissing)
            {
                <div class="alert alert-danger alert-custom mb-4" role="alert">
                    <h5 class="alert-heading">Calculations Required</h5>
                    <p class="mb-0">No Section 104 pools found. Please run the calculation first on the <a href="CalculatePage" class="alert-link">Calculate &amp; export page</a> before adding entries, so that available tickers and quantities can be populated.</p>
                </div>
            }

            <!-- ERI and Equalisation Controls -->
            <div class="row g-4 mb-5">
                <div class="col-xl-6">
                    <EriControl IsCalculationMissing="@_isCalculationMissing"
                                OnDataChanged="RefreshAll"
                                AllowManualAssetNameInput="false"
                                AssetCategoryFilter="@_stockAssetCategoryFilter" />
                </div>
                <div class="col-xl-6">
                    <EqualisationControl @ref="_equalisationControl"
                                         IsCalculationMissing="@_isCalculationMissing"
                                         OnDataChanged="RefreshAll"
                                         AllowManualAssetNameInput="false"
                                         AssetCategoryFilter="@_stockAssetCategoryFilter" />
                </div>
            </div>

            <!-- Corporate Action History Table -->
            <div class="section">
                <h3 class="mb-3">Corporate Action History (ERI & Equalisation)</h3>
                <RadzenDataGrid TItem="CorporateAction" Data="@History" AllowPaging="true" PageSize="10" AllowSorting="true" AllowColumnResize="true" CellRender="@(args => MobileCardGrid.LabelCell(args))"
                            class="w-100 mobile-cards">
                    <Columns>
                        <RadzenDataGridColumn TItem="CorporateAction" Property="@nameof(CorporateAction.AssetName)" Title="Ticker" Width="120px" />
                        <RadzenDataGridColumn TItem="CorporateAction" Property="@nameof(CorporateAction.Date)" Title="Date" FormatString="{0:d}" Width="150px" />
                        <RadzenDataGridColumn TItem="CorporateAction" Title="Type" Width="150px" Sortable="false">
                            <Template Context="ca">
                                @if (ca is ExcessReportableIncome eri)
                                {
                                    <span>ERI (@eri.IncomeType.GetDescription())</span>
                                    @if (eri.IsIncomeExcluded)
                                    {
                                        <div class="text-muted small" title="Imported with this income type not loaded: the Section 104 cost uplift applies but the income is not taxed.">Income not loaded</div>
                                    }
                                }
                                else if (ca is FundEqualisation fe)
                                {
                                    <span>Equalisation</span>
                                    @if (!HasIncome(fe))
                                    {
                                        <div class="text-danger small" title="No ERI entry or fund distribution of this asset on this date was found, so no income is reduced. The cost reduction still applies.">Income not found</div>
                                    }
                                }
                                else
                                {
                                    <span>@ca.GetType().Name</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CorporateAction" Title="Amount (Local)" Width="150px" Sortable="false">
                            <Template Context="ca">
                                @if (ca is ExcessReportableIncome eri)
                                {
                                    <span class="text-nowrap">@eri.Amount.Amount.ToString()</span>
                                }
                                else if (ca is FundEqualisation fe)
                                {
                                    <span class="text-nowrap">@fe.Amount.Amount.ToString()</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CorporateAction" Title="Amount (GBP)" Width="150px" Sortable="false">
                            <Template Context="ca">
                                @if (ca is ExcessReportableIncome eri)
                                {
                                    <span class="text-nowrap">@eri.Amount.BaseCurrencyAmount.Amount.ToString("N2")</span>
                                }
                                else if (ca is FundEqualisation fe)
                                {
                                    <span class="text-nowrap">@fe.Amount.BaseCurrencyAmount.Amount.ToString("N2")</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CorporateAction" Property="@nameof(CorporateAction.Reason)" Title="Details" />
                        <RadzenDataGridColumn TItem="CorporateAction" Title="Actions" Width="120px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                            <Template Context="ca">
                                <div class="d-flex gap-2 justify-content-center">
                                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => DeleteEntry(ca))" Text="Delete" class="flex-shrink-0" />
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control-plaintext {
        font-weight: bold;
        color: var(--wf-accent);
    }
</style>

@code {
    private List<CorporateAction> History { get; set; } = new();
    private EqualisationControl? _equalisationControl;
    
    private bool _isCalculationMissing = false;
    private bool _dataChanged = false;
    private IDisposable? _registration;
    private static readonly List<AssetCategoryType> _stockAssetCategoryFilter = [AssetCategoryType.STOCK, AssetCategoryType.FUND];

    protected override void OnInitialized()
    {
        _isCalculationMissing = !Section104Pools.GetSection104s().Any();
        RefreshHistory();

        _registration = NavigationManager.RegisterLocationChangingHandler(OnLocationChanging);
    }

    private void RefreshHistory()
    {
        History = TaxEventLists.CorporateActions
            .Where(e => e is ExcessReportableIncome or FundEqualisation)
            .OrderByDescending(e => e.Date)
            .ToList();
        StateHasChanged();
    }

    private void RefreshAll()
    {
        _dataChanged = true;
        // ERI and equalisation entries (and the dividend/interest events ERI generates) go straight into
        // TaxEventLists, so re-register the share identities instead of leaving them stale until the next
        // calculation or file import.
        ShareIdentityRegistry.RegisterEvents(TaxEventLists.AllEvents);
        RefreshHistory();
    }

    /// <summary>
    /// Whether the equalisation entry has income to reduce, for the "Income not found" marker.
    /// </summary>
    private bool HasIncome(FundEqualisation equalisation) => ReportingFundIncomeResolver.HasIncome(equalisation, TaxEventLists);

    /// <summary>
    /// Deletes an ERI or equalisation entry, together with any equalisation entries left without income, and warns
    /// about the latter.
    /// </summary>
    private void DeleteEntry(CorporateAction entry)
    {
        // Entries are self-contained: their income and Section 104 effects are derived at calculation time, so
        // removing the entry is all that is needed. Equalisation entries left without income are removed with it.
        bool removed = false;
        IncomeChangeResult change = EqualisationIntegrity.ApplyIncomeChange(TaxEventLists,
            () => removed = TaxEventLists.CorporateActions.Remove(entry));
        if (!removed) return;

        ToastService.ShowInformation(entry is ExcessReportableIncome
            ? $"Removed ERI entry for {entry.AssetName}."
            : $"Removed equalisation entry for {entry.AssetName}.");
        if (change.RemovedEqualisationsWarning is { } warning)
            {
                ToastService.ShowWarning(warning);
            }
        // The equalisation form may have the deleted ERI selected as its income.
        _equalisationControl?.Reset();
        RefreshAll();
    }

    private async ValueTask OnLocationChanging(LocationChangingContext context)
    {
        if (_dataChanged)
        {
            _dataChanged = false;
            await TaxCalculationService.CalculateAsync(CalculationTrigger.NavigationRefresh);
        }
    }

    public void Dispose()
    {
        _registration?.Dispose();
    }
}
