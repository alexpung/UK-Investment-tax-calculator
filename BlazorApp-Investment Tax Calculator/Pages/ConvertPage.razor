@page "/ConvertPage"

@using InvestmentTaxCalculator.Components

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <!-- Page Header -->
            <div class="page-header">
                <h1 class="page-title">Income Taxable Dividend Selection</h1>
                <p class="page-subtitle">Mark dividends that should be treated as income rather than dividends</p>
            </div>

            <!-- Main Content Section -->
            <div class="section">
                <DividendToIncomeConvert OnConverted="() => _recalculate.MarkChanged()" />
                <RecalculateOnLeave @ref="_recalculate" />
            </div>
        </div>
    </div>
</div>

@code {
    private RecalculateOnLeave _recalculate = default!;
}
