@page "/MainCalculatorPage"

@using InvestmentTaxCalculator.Components
@using InvestmentTaxCalculator.ViewModel

<PageTitle>Import data · UK Investment Tax Calculator</PageTitle>

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-xl-10 mx-auto">
            <!-- Page Header -->
            <div class="page-header">
                <h1 class="page-title">Import data</h1>
                <p class="page-subtitle">Import broker statements, or a JSON session previously exported by this app</p>
            </div>

            <!-- Import Section -->
            <div class="section">
                <ImportFile/>
            </div>

            <!-- What happens next -->
            <div class="card next-steps-card" data-testid="next-steps">
                <div class="card-header">
                    <h3 class="mb-0">What happens next</h3>
                </div>
                <div class="card-body">
                    <ol class="next-steps-list">
                        <li>
                            <a href="@WorkflowSteps.CalculatePage">Calculate &amp; export</a>
                            <span>Run the calculation to see your totals and export the results.</span>
                        </li>
                        <li>
                            <strong>Adjust, if needed</strong>
                            <span>
                                These pages pick from the tickers and holdings your data and calculation produce, so use them after the first calculation.
                                The calculation runs again when you leave a page you changed.
                            </span>
                            <ul class="next-steps-sublist">
                                <li><a href="ConvertPage">Income taxable dividend selection</a> — bond ETFs whose distributions are taxed as interest.</li>
                                <li><a href="AddExcessReportableIncome">ERI and Equalisation</a> — offshore reporting funds.</li>
                                <li><a href="corporate-actions">Corporate Actions and Events</a> — takeovers, spin-offs and other events your broker does not fully report.</li>
                                <li><a href="AddTradePage">Add Manual Entries</a> — trades, dividends or interest missing from your statements.</li>
                                <li><a href="ResidencyStatusPage">Residency Status</a> — periods of non-residence or split years.</li>
                            </ul>
                        </li>
                    </ol>

                    <a href="@WorkflowSteps.CalculatePage" class="btn-workflow-primary">Continue to Calculate <span aria-hidden="true">→</span></a>
                </div>
            </div>
        </div>
    </div>
</div>
