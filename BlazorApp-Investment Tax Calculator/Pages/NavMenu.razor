@using InvestmentTaxCalculator.Model
@using InvestmentTaxCalculator.Services
@using InvestmentTaxCalculator.ViewModel
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject NavigationManager Navigation
@inject TaxEventLists TaxEventLists
@inject TradeCalculationResult TradeCalculationResult
@inject DividendCalculationResult DividendCalculationResult
@inject TaxCalculationService TaxCalculationService
@inject FileImportStateService FileImportState

<button class="mobile-nav-toggle" @onclick="ToggleMenu" aria-label="Toggle navigation" aria-expanded="@(SidebarToggle ? "true" : "false")">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
    Menu
</button>

@if (SidebarToggle)
{
    <div class="sidebar-backdrop" @onclick="ToggleMenu"></div>
}

<nav class="sidebar-nav @(SidebarToggle ? "show" : "")" aria-label="Tax workflow">
    <div class="sidebar-header">
        <NavLink href="" class="sidebar-brand" Match="NavLinkMatch.All" @onclick="CloseMenuOnMobile">
            <span class="brand-mark" aria-hidden="true">£</span>
            <span class="brand-text">UK Investment<br />Tax Calculator</span>
        </NavLink>
    </div>

    <div class="sidebar-menu">
        <NavLink href="" class="nav-link-custom nav-home" Match="NavLinkMatch.All" @onclick="CloseMenuOnMobile">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" /></svg>
            <span>Home</span>
        </NavLink>

        <ol class="workflow-steps">
            @foreach (var step in WorkflowSteps.All)
            {
                var state = GetState(step);
                <li class="workflow-step @CssClassFor(state)" aria-current="@(state == StepState.Current ? "step" : null)">
                    <div class="workflow-marker" aria-hidden="true">
                        <span class="workflow-number">
                            @if (state == StepState.Done)
                            {
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12l5 5 9-10" /></svg>
                            }
                            else
                            {
                                @step.Number
                            }
                        </span>
                        <span class="workflow-line"></span>
                    </div>
                    <div class="workflow-body">
                        <div class="workflow-title" title="@step.Hint"><span class="visually-hidden">Step @step.Number: </span>@step.Title@if (step.IsOptional)
                            {
                                <span class="workflow-optional-tag">Optional</span>
                            }</div>
                        <ul class="workflow-links">
                            @foreach (var link in step.Links)
                            {
                                <li>
                                    <NavLink href="@link.PageAddress" class="nav-link-custom" Match="NavLinkMatch.All" @onclick="CloseMenuOnMobile">@link.Text</NavLink>
                                </li>
                            }
                        </ul>
                    </div>
                </li>
            }
        </ol>

        <div class="sidebar-footer">
            <NavLink href="AcknowledgementPage" class="nav-link-custom nav-footer-link" Match="NavLinkMatch.All" @onclick="CloseMenuOnMobile">Acknowledgement</NavLink>
            <div class="sidebar-footer-actions">
                <a href="https://github.com/sponsors/alexpung" target="_blank" rel="noopener noreferrer">Sponsor</a>
                <a href="https://github.com/alexpung/UK-Investment-tax-calculator" target="_blank" rel="noopener noreferrer">Star on GitHub</a>
            </div>
        </div>
    </div>
</nav>

@code {
    public bool SidebarToggle { get; set; } = false;

    private enum StepState { Upcoming, Current, Done }

    private string _relativePath = "";

    protected override void OnInitialized()
    {
        _relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.LocationChanged += HandleLocationChanged;
        TaxCalculationService.OnStateChanged += HandleStateChanged;
        FileImportState.OnChange += HandleStateChanged;
    }

    private StepState GetState(WorkflowStep step)
    {
        if (step.Contains(_relativePath)) return StepState.Current;
        bool done = step.Number switch
        {
            1 => TaxEventLists.GetTotalNumberOfEvents() > 0,
            2 => !TradeCalculationResult.CalculatedTrade.IsEmpty || DividendCalculationResult.DividendSummary.Count > 0,
            _ => false
        };
        return done ? StepState.Done : StepState.Upcoming;
    }

    private static string CssClassFor(StepState state) => state switch
    {
        StepState.Current => "is-current",
        StepState.Done => "is-done",
        _ => "is-upcoming"
    };

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _relativePath = Navigation.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    private void HandleStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void ToggleMenu()
    {
        SidebarToggle = !SidebarToggle;
    }

    private void CloseMenuOnMobile()
    {
        if (SidebarToggle)
        {
            SidebarToggle = false;
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
        TaxCalculationService.OnStateChanged -= HandleStateChanged;
        FileImportState.OnChange -= HandleStateChanged;
    }
}
